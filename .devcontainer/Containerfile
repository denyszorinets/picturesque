FROM fedora:44

ARG TARGETARCH
ENV RUST_VERSION=1.99.0

RUN dnf update -y && \
    dnf install -y \
        zsh \
        git \
        curl \
        wget \
        file \
        neovim \
        gh \
        nodejs22 \
        nodejs22-bin \
        nodejs22-npm \
        nodejs22-npm-bin

# C toolchain, pkg-config and libclang (used by bindgen in *-sys crates)
RUN dnf install -y \
        @c-development \
        pkgconf-pkg-config \
        clang \
        clang-devel

# Tauri 2 system dependencies (https://v2.tauri.app/start/prerequisites/#linux)
RUN dnf install -y \
        webkit2gtk4.1-devel \
        openssl-devel \
        libappindicator-gtk3-devel \
        librsvg2-devel \
        libxdo-devel

# Image decoding: libvips (+ HEIF module), libheif and LibRaw
RUN dnf install -y \
        vips-devel \
        vips-heif \
        vips-tools \
        libheif-devel \
        libheif-ffmpeg \
        libheif-tools \
        LibRaw-devel && \
    dnf clean all

RUN curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh | bash
RUN chsh -s $(which zsh)

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y \
        --default-toolchain ${RUST_VERSION} \
        --component clippy,rustfmt,rust-analyzer
ENV PATH="/root/.cargo/bin:${PATH}"

RUN curl -fsSL https://bun.sh/install | bash
ENV PATH="/root/.bun/bin:${PATH}"

RUN curl -LsSf https://astral.sh/uv/install.sh | sh

RUN curl -fsSL https://claude.ai/install.sh | bash
ENV PATH="/root/.local/bin:${PATH}"
