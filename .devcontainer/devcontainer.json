{
    "name": "Picturesque dev container",
    "build": {
        "dockerfile": "Containerfile",
        "context": "."
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "rust-lang.rust-analyzer",
                "tauri-apps.tauri-vscode",
                "svelte.svelte-vscode",
                "tamasfe.even-better-toml",
                "vadimcn.vscode-lldb",
                "anthropic.claude-code"
            ],
            "mcp": {
                "servers": {
                    "filesystem": {
                        "command": "npx",
                        "args": [
                            "-y",
                            "@modelcontextprotocol/server-filesystem",
                            "/app"
                        ]
                    }
                }
            }
        }
    },
    "runArgs": ["--device=/dev/dri", "--group-add=keep-groups"],
    "workspaceFolder": "/app",
    "workspaceMount": "source=${localWorkspaceFolder},target=/app,type=bind",
    "mounts": [
        "source=${localWorkspaceFolderBasename}_claude,target=/root/.claude,type=volume",
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/root/.ssh,type=bind,readonly",
        "source=${localWorkspaceFolderBasename}_gh,target=/root/.config/gh,type=volume",
        "source=${localWorkspaceFolderBasename}_cargo_registry,target=/root/.cargo/registry,type=volume"
    ]
}