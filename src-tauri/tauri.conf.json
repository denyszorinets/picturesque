{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Picturesque",
  "version": "0.1.5",
  "identifier": "io.github.denyszorinets.picturesque",
  "build": {
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../ui/dist",
    "beforeDevCommand": "npm run dev -w ui",
    "beforeBuildCommand": "npm run build -w ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Picturesque",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: picturesque: http://picturesque.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Photography",
    "shortDescription": "Cull photos: series, best shots and local AI",
    "longDescription": "Picturesque imports photos into a clean library, groups bursts into series, highlights the best shots with technical analysis and on-device AI, and exports your picks.",
    "license": "GPL-3.0-or-later",
    "homepage": "https://github.com/denyszorinets/picturesque",
    "linux": {
      "deb": {
        "depends": [
          "libvips42t64 | libvips42",
          "libraw23t64 | libraw23",
          "libheif1",
          "libayatana-appindicator3-1 | libappindicator3-1"
        ],
        "files": {
          "/usr/lib/picturesque/libonnxruntime.so": "../target/release/libonnxruntime.so",
          "/usr/lib/picturesque/libwebgpu_dawn.so": "../target/release/libwebgpu_dawn.so",
          "/usr/lib/picturesque/critic": "../target/release/critic"
        }
      },
      "rpm": {
        "depends": [
          "vips",
          "LibRaw",
          "libheif",
          "libayatana-appindicator-gtk3"
        ],
        "files": {
          "/usr/lib/picturesque/libonnxruntime.so": "../target/release/libonnxruntime.so",
          "/usr/lib/picturesque/libwebgpu_dawn.so": "../target/release/libwebgpu_dawn.so",
          "/usr/lib/picturesque/critic": "../target/release/critic"
        }
      },
      "appimage": {
        "files": {
          "/usr/lib/picturesque/libonnxruntime.so": "../target/release/libonnxruntime.so",
          "/usr/lib/picturesque/libwebgpu_dawn.so": "../target/release/libwebgpu_dawn.so",
          "/usr/lib/picturesque/critic": "../target/release/critic"
        }
      }
    }
  }
}
