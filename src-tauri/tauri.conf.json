{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Picturesque",
  "version": "0.1.0",
  "identifier": "io.github.denyszorinets.picturesque",
  "build": {
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../ui/dist",
    "beforeDevCommand": "npm run dev -w ui",
    "beforeBuildCommand": "npm run build -w ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Picturesque",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
